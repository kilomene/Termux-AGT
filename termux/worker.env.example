# Termux-AGT worker config example.
# Generated for real by termux/setup-termux.sh — copy to
# ~/agent-host/config/worker.env (mode 600) and fill in the secrets.

# Control plane to dial out to (the worker never listens inbound).
WORKER_CONTROL_PLANE_URL=https://uaht.novamail.store

# This phone's identity on the control plane.
WORKER_HOST_NAME=termux-phone
WORKER_HOST_ID=
WORKER_HOST_TOKEN=

# Termux backend: Docker-free process deployments, termux-only manifests.
WORKER_TERMUX=true
WORKER_CAPABILITIES=termux

# Loops.
WORKER_POLL_WAIT=25
WORKER_HEARTBEAT_INTERVAL=30

# Termux-aware paths (the installer writes these; shown for reference).
WORKER_WORK_DIR=/data/data/com.termux/files/home/agent-host
WORKER_APPS_DIR=/data/data/com.termux/files/home/agent-apps

# Reported to the control plane; read from agent/config.py at install time.
WORKER_WORKER_VERSION=0.1.0
